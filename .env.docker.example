APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=INFO
APP_API_KEY=replace_with_a_long_random_secret
ALLOWED_ORIGINS=http://localhost:8501

# Docker/Linux should use SQL authentication and TCP/IP.
SQL_SERVER=host.docker.internal,1433
SQL_DATABASE=InsuranceAnalyticsDB
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_USERNAME=YOUR_SQL_LOGIN
SQL_PASSWORD=YOUR_SQL_PASSWORD

LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434

API_BASE_URL=http://api:8001
